# The standard build: patches applied, optimised for compile time rather than
# runtime. This is the one to use while developing patches.
#
# The name must keep matching out/baseline: siso records absolute paths, so
# renaming the output directory forces a full rebuild that renaming back
# does not undo.
#
# Validated: this configuration builds Chromium 151.0.7922.174 on Windows.

is_debug = false
is_component_build = false

# Symbols dominate link time and nothing here is being debugged yet.
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# PGO instrumentation roughly triples build time.
chrome_pgo_phase = 0

# Remote execution is unavailable to external contributors on Windows.
use_remoteexec = false

treat_warnings_as_errors = false

# Matches release.gn, because without it a development build runs a different
# feature set from the shipped one and every measurement taken here describes a
# browser nobody gets. testing/variations/fieldtrial_testing_config.json is
# compiled in and applied by default in an unbranded build, and it force-enables
# features the source marks disabled.
#
# Measured with utils/audit_components.py on a cold profile: it turns 346 MB of
# component downloads into 28 MB. PreemptiveSodaDownload alone fetches the
# speech recogniser and a language pack, 237 MB, with Live Caption switched off,
# and AutoDownloadTranslateLanguagePacks adds a 79 MB translation model.
disable_fieldtrial_testing_config = true

# Network Error Logging and the Reporting API let a site register a collector
# and then receive beacons about requests out of band, after the page is gone.
# Nothing in the browser needs them, so they come out at build time rather than
# being left compiled in behind a pref.
enable_reporting = false

# The remote desktop host. Nothing here drives it and it is not reachable from
# the UI, so it is dead code that only widens the binary.
enable_remoting = false

# Also matches release.gn. Both default off in an unbranded build, and the
# effect is not subtle: canPlayType on this build before setting them returned
# nothing for avc1.42E01E and mp4a.40.2, so every H.264 or AAC stream on the
# web failed here while playing normally in the shipped build. Any media
# behaviour checked against a development build without these describes a
# browser nobody gets.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
