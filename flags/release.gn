# Shipping build. Optimised for runtime, expensive to compile.
#
# gn resolves this configuration against Chromium 151, but it has not been
# compiled end to end yet. PGO requires "checkout_pgo_profiles": True in the
# .gclient custom_vars, followed by gclient runhooks, or gn fails outright.

is_debug = false
is_component_build = false

# Full optimisation, LTO and profile-guided optimisation.
is_official_build = true

# Without these, H.264 and AAC are absent and most video on the web fails.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# testing/variations/fieldtrial_testing_config.json is compiled into the binary
# and force-enables 1503 experiment groups, overriding what the source says.
# So a feature marked FEATURE_DISABLED_BY_DEFAULT still ships on: the sign-in
# promo pill is kSigninPromoOnAvatarPill, disabled in signin_switches.cc, and
# enabled for Windows by that JSON. Without this arg the shipped defaults are
# not the ones anyone reading the code would expect.
disable_fieldtrial_testing_config = true

# Safe Browsing is left compiled in, but it does nothing here and should be
# switched off at the pref rather than the build.
#
# safe_browsing_mode defaults to 1 on Windows, so the service runs and standard
# protection is on. What it cannot do is authenticate. google_api_key defaults
# to "" and google_apis/BUILD.gn only emits the GOOGLE_API_KEY define when that
# string is non-empty, so GetAPIKey() falls through to
# DefaultApiKeys::kUnsetApiToken, which is the literal "dummytoken" rather than
# an empty string. Every call site guards with if (!api_key.empty()), and
# "dummytoken" is not empty, so the key is appended and
# safebrowsing.googleapis.com is asked to honour it.
#
# That is the worst of both: on a local-cache miss the request still leaves the
# machine, carrying our IP and 4-byte SHA256 prefixes of the URL, and the
# server rejects it, so no verdict ever comes back. Setting google_api_key=""
# does not help, being already the default.
#
# safe_browsing_mode = 0 does remove it, but several chrome/ targets still
# depend on the components it drops and gn fails with unresolved dependencies;
# fixing that takes four separate build patches, re-based every four weeks.
# Defaulting the kSafeBrowsingEnabled pref to false is one line and stops the
# same traffic, so that is the route to take. Nothing is lost by it: protection
# that cannot authenticate was never protection.

use_remoteexec = false
treat_warnings_as_errors = false

# is_official_build carries the optimisation work, and it was checked at the
# compiler rather than inferred from the gn logic. A live clang-cl command line
# in this configuration carries:
#
#   -fprofile-use=chrome/build/pgo_profiles/chrome-win64-7922-*.profdata
#   -flto=thin
#   /O2 /clang:-O2 /Oy-
#
# The profile is branch-matched: 7922 is this pinned Chromium, so the sample
# data describes the code actually being compiled.
#
# is_official_build also settles three arguments that would otherwise look like
# things to set by hand. chrome_pgo_phase reaches 2 only when dcheck_always_on
# is false, which is_official_build already makes it, so PGO and DCHECKs are one
# decision rather than two. optimize_webui is !is_debug, so already on. NaCl is
# no longer in the tree to switch off.
#
# Measured, so the build cost is justified rather than assumed. Against
# out/baseline, same tree and same 151.0.7922.174, five runs each, medians:
#
#   startup   282 ms vs 436 ms   -35%
#   memory   1205 MB vs 1731 MB  -30%   (8 tabs, whole process tree)
#
# Read that as what is_official_build buys over a build tuned for compile time,
# and nothing more. It is not a comparison against any browser anyone ships,
# because out/baseline is not one: every shipping Chromium already has PGO and
# LTO, so this delta is the cost of not having them, not a lead over them. No
# public claim can rest on these two numbers.
#
# There is nothing further to gain from gn arguments here. Anything beyond this
# has to come from measurement, not flags.
#
# An AVX2 baseline was the next candidate and is on hold. There is no GN
# argument for it: this Chromium declares neither extra_cflags nor an ISA-level
# arg, so raising the baseline means patching build/config/compiler. Against
# that, the hot SIMD paths in Skia, V8, libvpx and dav1d already dispatch on
# AVX2 at runtime whatever the compile baseline, and a raised baseline makes
# the binary refuse to start on any pre-2013 CPU. A patch with a permanent
# rebase cost, an unmeasured gain and a hard compatibility floor is the wrong
# trade until benchmarks say otherwise.
