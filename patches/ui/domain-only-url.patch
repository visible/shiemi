+bool ChromeLocationBarModelDelegate::ShouldTrimDisplayUrlAfterHostName() const {
+  Profile* const profile = GetProfile();
+  if (!profile || !profile->GetPrefs()->GetBoolean(prefs::kDomainOnlyUrl)) {
+    return false;
+  }
+  // Both halves of ShouldPreventElision, which cannot be called here because
+  // it is non-const. A certificate problem is exactly when the whole URL has
+  // to stay readable.
+  if (profile->GetPrefs()->GetBoolean(omnibox::kPreventUrlElisionsInOmnibox)) {
+    return false;
+  }
+  return !net::IsCertStatusError(GetVisibleSecurityState()->cert_status);
+}
