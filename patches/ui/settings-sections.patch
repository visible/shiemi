--- /dev/null
+++ b/chrome/browser/resources/settings/shiemi_page/shiemi_page.ts
@@ -0,0 +1,49 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-shiemi-page' holds the options that belong to this browser rather
+ * than to upstream, so they are not scattered through pages built for
+ * something else.
+ */
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './shiemi_page.html.js';
+
+const SettingsShiemiPageElementBase = PrefsMixin(PolymerElement);
+
+export class SettingsShiemiPageElement extends SettingsShiemiPageElementBase
+    implements SettingsPlugin {
+  static get is() {
+    return 'settings-shiemi-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  // SettingsPlugin implementation. Not optional: settings-main calls this on
+  // every element it hosts, whether or not the page has anything to search.
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-shiemi-page': SettingsShiemiPageElement;
+  }
+}
+
+customElements.define(SettingsShiemiPageElement.is, SettingsShiemiPageElement);
