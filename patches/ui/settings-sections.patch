   html_source->AddLocalizedStrings(kLocalizedStrings);
 
+  // Our own strings, not upstream's, so they are not in a .grd: settings_strings
+  // is rewritten wholesale at build time to carry the product name, and a hunk
+  // in there would be discarded by that step.
+  html_source->AddString("shiemiPageTitle", u"Shiemi");
+  html_source->AddString("containedFullscreen",
+                         u"Full screen stays inside the window");
+  html_source->AddString(
+      "containedFullscreenDesc",
+      u"A video going full screen fills this window instead of the whole "
+      u"display, so the rest of your desktop stays where it is. Shift-click a "
+      u"player's full screen button for the other one.");
+
   html_source->AddBoolean("ntpSimplificationBookmarksBarEnabled",
                           base::FeatureList::IsEnabled(
                               ntp_features::kNtpSimplificationBookmarkBar));
