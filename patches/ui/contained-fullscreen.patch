 namespace {
 
+// True while the active tab holds a contained fullscreen, where the page fills
+// the window but the window stays a window.
+//
+// The same within-tab mechanism also backs tab capture, which deliberately
+// leaves the window untouched, so a captured tab is excluded: collapsing the
+// toolbar under a recording would be a surprise rather than a feature.
+bool IsActiveTabContainedFullscreen(BrowserWindowInterface* browser) {
+  Profile* const profile = browser->GetProfile();
+  if (!profile ||
+      !profile->GetPrefs()->GetBoolean(prefs::kContainedFullscreen)) {
+    return false;
+  }
+
+  const TabStripModel* const tabs = browser->GetTabStripModel();
+  content::WebContents* const contents =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  if (!contents || contents->IsBeingVisiblyCaptured()) {
+    return false;
+  }
+
+  const FullscreenWithinTabHelper* const helper =
+      FullscreenWithinTabHelper::FromWebContents(contents);
+  return helper && helper->is_fullscreen_within_tab();
+}
