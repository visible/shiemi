+bool BrowserWindowFullscreenController::IsContainedFullscreen() const {
+  // Deliberately not gated on the preference. The preference only picks which
+  // mode a request enters, and Ctrl inverts it, so once a tab is in contained
+  // fullscreen the helper is the only thing that knows.
+  //
+  // The same within-tab mechanism also backs tab capture, which purposely
+  // leaves the window untouched, so a captured tab is excluded: collapsing the
+  // toolbar under a recording would be a surprise rather than a feature.
+  const TabStripModel* const tabs = browser_->GetTabStripModel();
+  content::WebContents* const contents =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  if (!contents || contents->IsBeingVisiblyCaptured()) {
+    return false;
+  }
+
+  const FullscreenWithinTabHelper* const helper =
+      FullscreenWithinTabHelper::FromWebContents(contents);
+  return helper && helper->is_fullscreen_within_tab();
+}
+
 bool BrowserWindowFullscreenController::IsForceFullscreen() const {
   return force_fullscreen_;
 }
