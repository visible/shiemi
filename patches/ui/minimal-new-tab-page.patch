+// Shown once per profile, in place of the tiles, which have nothing to show on
+// a first run anyway. Kept in localStorage rather than a pref so the greeting
+// costs no browser-side plumbing; clearing site data brings it back once.
+const WELCOMED_KEY = 'shiemi.welcomed';
+
+const page = document.querySelector<HTMLElement>('#page');
+const dismiss = document.querySelector<HTMLButtonElement>('#dismiss');
+assert(page);
+assert(dismiss);
+
+function welcomed(): boolean {
+  try {
+    return localStorage.getItem(WELCOMED_KEY) === '1';
+  } catch {
+    return true;
+  }
+}
+
+if (!welcomed()) {
+  page.toggleAttribute('welcoming', true);
+  dismiss.addEventListener('click', () => {
+    try {
+      localStorage.setItem(WELCOMED_KEY, '1');
+    } catch {
+    }
+    page.toggleAttribute('welcoming', false);
+  });
+}
