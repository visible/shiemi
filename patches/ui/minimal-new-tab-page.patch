+// Light text means a dark surface behind it. Taken from the theme rather than
+// prefers-color-scheme so the page follows the browser theme, which can differ
+// from the system one.
+function impliesDarkSurface(textColor: {value: number}): boolean {
+  const r = (textColor.value >> 16) & 0xff;
+  const g = (textColor.value >> 8) & 0xff;
+  const b = textColor.value & 0xff;
+  return 0.299 * r + 0.587 * g + 0.114 * b > 128;
+}
