__pycache__/
*.pyc

# Screenshots from the capture tools, which write whatever name they are
# given. Kept out of the tree because they are large, they are regenerated on
# every UI change, and a stale one is worse than none. Root only, so branding
# assets are unaffected.
/*.png

# Profile that launch.py builds for hand testing.
.profile/

# Installers package.py produces. They belong on a release, not in git.
dist/

# Downloads fetch_ublock.py keeps between builds. A build input, pinned by
# checksum in the script, so nothing is lost by refetching it.
.cache/
.env*
node_modules/
.next/
next-env.d.ts
tsconfig.tsbuildinfo
.vercel
